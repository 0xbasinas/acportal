[
  {
    "id": "custom-native",
    "name": "Custom native ACP agent",
    "command": "/opt/acp/bin/custom-agent",
    "args": ["acp"],
    "transport": "stdio",
    "enabled": false,
    "env": {}
  },
  {
    "id": "custom-node-windows",
    "name": "Installed Node ACP adapter on Windows",
    "command": "C:/Program Files/nodejs/node.exe",
    "args": ["C:/ACPPortal/adapters/custom-agent/server.mjs", "--stdio"],
    "transport": "stdio",
    "enabled": false,
    "env": {}
  },
  {
    "id": "opencode",
    "name": "OpenCode (native binary)",
    "command": "/usr/local/bin/opencode",
    "args": ["acp"],
    "transport": "stdio",
    "enabled": false,
    "env": {},
    "ownTools": true
  },
  {
    "id": "gemini-cli-node",
    "name": "Gemini CLI through Node",
    "command": "/usr/bin/node",
    "args": ["/opt/acp/gemini-cli/node_modules/@google/gemini-cli/bundle/gemini.js", "--acp"],
    "transport": "stdio",
    "enabled": false,
    "env": {}
  }
]
